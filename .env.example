# 基本配置
PORT=8080
PASSWORD=111111
DEBUG=false

# CORS 配置
CORS_ORIGIN=*

# 请求配置
# 单次上游请求超时（毫秒）。别收得太紧，4~8s 才回应的采集源很常见
REQUEST_TIMEOUT=8000
# 单个代理请求的总时间预算（毫秒）：所有重试加起来不超过它，超过立即返回 504
REQUEST_TOTAL_TIMEOUT=10000
# 仅对瞬时网络错误重试，证书过期/403/404 等永久错误不会重试
MAX_RETRIES=2
# 同时发往上游的最大请求数（防止一次搜索扇出过多连接）
MAX_UPSTREAM_CONCURRENCY=16
# 同一 host 连续失败多少次后熔断，以及冷却时长（秒）
BREAKER_THRESHOLD=4
BREAKER_COOLDOWN=60
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# 缓存配置
CACHE_MAX_AGE=1d

# 安全配置
BLOCKED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1
BLOCKED_IP_PREFIXES=192.168.,10.,172.
FILTERED_HEADERS=content-security-policy,cookie,set-cookie,x-frame-options,access-control-allow-origin
